      "updated": 1732956185025,
      "link": null,
      "locked": false,
      "text": "Case 1: Exceeding Area Limits\nOverview:\nIn this case, a tile moves beyond the allowed area. When it reaches a red\ntile, it should not stop but continue moving until it reaches a green tile.",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Case 1: Exceeding Area Limits\nOverview:\nIn this case, a tile moves beyond the allowed area. When it reaches a red\ntile, it should not stop but continue moving until it reaches a green tile.",
      "autoResize": true,
      "lineHeight": 1.25
    },
